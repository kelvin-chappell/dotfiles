#!/usr/bin/env bash
set -euo pipefail

# Dev container dotfiles installer.
# Symlinks the dotfiles from the portable packages in this repo into $HOME,
# backing up any pre-existing files before replacing them. Intended to run as
# a devcontainer.json "postCreateCommand" (or "updateContentCommand").

# Resolve the directory containing this script.
DOTFILES_DIR="$(cd -P "$(dirname "${BASH_SOURCE[0]}")" >/dev/null 2>&1 && pwd)"

# Portable packages only. The brew package is macOS-only and is never linked.
PACKAGES=(git zsh shell config agents)

# Paths (relative to $HOME) inside the packages that should never be linked
# in a dev container. Any file under these paths is skipped.
EXCLUDES=(.config/mise .config/gh)

# Backup location for any files we replace. Create it lazily so an idempotent
# run does not leave an empty backup directory.
BACKUP_DIR=""

create_backup_dir() {
  if [ -z "$BACKUP_DIR" ]; then
    mkdir -p "$HOME/.dotfiles-backup"
    BACKUP_DIR="$(mktemp -d "$HOME/.dotfiles-backup/$(date +%Y%m%d-%H%M%S)-XXXXXX")"
  fi
}

is_excluded() {
  local rel="$1" ex
  for ex in "${EXCLUDES[@]}"; do
    case "$rel" in
      "$ex" | "$ex"/*) return 0 ;;
    esac
  done
  return 1
}

for pkg in "${PACKAGES[@]}"; do
  pkg_dir="$DOTFILES_DIR/$pkg"
  [ -d "$pkg_dir" ] || continue

  while IFS= read -r -d '' file; do
    rel="${file#"$pkg_dir"/}"

    # Skip subpackages that aren't wanted in dev containers.
    if is_excluded "$rel"; then
      continue
    fi

    target="$HOME/$rel"

    # Leave an already-correct symlink untouched.
    if [ -L "$target" ] && [ "$(readlink "$target")" = "$file" ]; then
      continue
    fi

    # Back up any conflicting path, including dangling symlinks.
    if [ -e "$target" ] || [ -L "$target" ]; then
      create_backup_dir
      mkdir -p "$BACKUP_DIR/$(dirname "$rel")"
      mv "$target" "$BACKUP_DIR/$rel"
      echo "Backed up existing $target -> $BACKUP_DIR/$rel"
    fi

    mkdir -p "$(dirname "$target")"
    ln -s "$file" "$target"
  done < <(find "$pkg_dir" -type f -print0)
done

. "$DOTFILES_DIR/scripts/ensure-bash-aliases.sh"
ensure_bash_aliases

echo "Dotfiles symlinked into $HOME successfully."
if [ -n "$BACKUP_DIR" ]; then
  echo "Any replaced files were backed up under $BACKUP_DIR."
fi
