{
  "mcpServers": {
    "aws-mcp": {
      "type": "stdio",
      "command": "/home/vscode/.local/bin/uvx",
      "args": [
        "mcp-proxy-for-aws-cli@latest",
        "https://aws-mcp.us-east-1.api.aws/mcp",
        "--metadata",
        "AWS_REGION=eu-west-1"
      ],
      "env": {
        "AWS_MCP_PROXY_PROFILES": "deployTools"
      }
    }
  }
}
